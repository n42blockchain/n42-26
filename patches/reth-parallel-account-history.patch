+    #[test]
+    fn test_parallel_account_history_shards_match_serial() {
+        let limit = NUM_OF_INDICES_IN_SHARD as u64;
+        // Accounts with no shard, a partly filled one, and one that splits.
+        let entries = |round: u64| -> BTreeMap<Address, Vec<u64>> {
+            (0..64u8)
+                .map(|n| {
+                    let count = if n % 3 == 0 { limit + 5 } else { 1 + n as u64 };
+                    let first = round * 10 * limit;
+                    (Address::repeat_byte(n), (first..first + count).collect())
+                })
+                .collect()
+        };
+        let dump = |provider: &RocksDBProvider| -> Vec<(ShardedKey<Address>, BlockNumberList)> {
+            provider
+                .iter::<tables::AccountsHistory>()
+                .unwrap()
+                .map(|entry| entry.unwrap())
+                .collect()
+        };
+        let serial_dir = TempDir::new().unwrap();
+        let serial = RocksDBBuilder::new(serial_dir.path()).with_default_tables().build().unwrap();
+        let parallel_dir = TempDir::new().unwrap();
+        let parallel =
+            RocksDBBuilder::new(parallel_dir.path()).with_default_tables().build().unwrap();
+        for round in 0..3 {
+            let mut batch = serial.batch();
+            for (address, indices) in entries(round) {
+                batch.append_account_history_shard(address, indices).unwrap();
+            }
+            batch.commit().unwrap();
+            let mut batch = parallel.batch();
+            batch.append_account_history_shards(entries(round)).unwrap();
+            batch.commit().unwrap();
+        }
+        let written = dump(&serial);
+        assert!(written.len() > 64, "some accounts split into several shards");
+        assert_eq!(written, dump(&parallel));
+    }
