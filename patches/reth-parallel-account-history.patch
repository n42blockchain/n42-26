+/// `N42_PARALLEL_ACCOUNT_HISTORY=1`: a block's account history shards are
+/// read and extended on the worker pool, as storage history shards are, instead
+/// of one account after another. The batch written is the same.
+pub fn parallel_account_history() -> bool {
+    static ON: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *ON.get_or_init(|| std::env::var("N42_PARALLEL_ACCOUNT_HISTORY").is_ok_and(|v| v == "1"))
+}
