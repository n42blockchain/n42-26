+    /// Writes `total` bytes as `value_len`-byte values to `TestTable` and `TestTable2` in
+    /// `WriteBatch`es of about 4 MiB (the production write path), on a thread. Returns the
+    /// write time, or `None` when it did not finish within `timeout` (the writer, provider and
+    /// directory are then leaked, so a stalled write cannot hang the test).
+    fn write_batches_within(
+        provider: &RocksDBProvider,
+        total: usize,
+        value_len: usize,
+        timeout: std::time::Duration,
+    ) -> Option<std::time::Duration> {
+        let writer = provider.clone();
+        let (done_tx, done_rx) = std::sync::mpsc::channel();
+        std::thread::spawn(move || {
+            let started = std::time::Instant::now();
+            let value = vec![7u8; value_len];
+            let per_batch = ((4 << 20) / value_len).max(1) as u64;
+            let count = (total / value_len) as u64;
+            let mut key = 0;
+            while key < count {
+                let end = (key + per_batch).min(count);
+                writer
+                    .write_batch(|batch| {
+                        for k in key..end {
+                            if k % 2 == 0 {
+                                batch.put::<TestTable>(k, &value)?;
+                            } else {
+                                batch.put::<TestTable2>(k, &value)?;
+                            }
+                        }
+                        Ok(())
+                    })
+                    .unwrap();
+                key = end;
+            }
+            let _ = done_tx.send(started.elapsed());
+        });
+        done_rx.recv_timeout(timeout).ok()
+    }
