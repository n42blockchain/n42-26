 const DEFAULT_WRITE_BUFFER_MANAGER_SIZE: usize = 4 * 1024 * 1024 * 1024;
 
+/// Default N42 memtable budget across column families (512 MiB), see [`memtable_budget`].
+const DEFAULT_N42_MEMTABLE_BUDGET: usize = 512 << 20;
+
+/// Bound on the flushed memtables a column family keeps as history under a memtable budget.
+///
+/// `OptimisticTransactionDB::Open` replaces 0 with -1 (`max_write_buffer_number x
+/// write_buffer_size`), so 0 cannot switch the history off. One byte is the smallest bound it
+/// keeps: a flush still moves the newest flushed memtable into the history, and the next write
+/// to that column family frees it. The history serves only conflict checks of optimistic
+/// transactions, which the node does not commit (it writes `WriteBatch`es).
+const BOUNDED_MEMTABLE_HISTORY: i64 = 1;
+
+/// The memtable budget in bytes (`N42_ROCKSDB_MEMTABLE_MB`).
+///
+/// Unset: [`DEFAULT_N42_MEMTABLE_BUDGET`]. `0`: none, upstream's memtables
+/// ([`DEFAULT_WRITE_BUFFER_MANAGER_SIZE`], [`DEFAULT_WRITE_BUFFER_SIZE`], history of
+/// `OptimisticTransactionDB`'s default two memtables per column family).
+///
+/// Upstream's memtables are not bounded by the write buffer manager alone:
+/// `OptimisticTransactionDB` keeps up to two flushed memtables per column family as conflict
+/// check history, still charged to the manager, so a node's memtables grow towards
+/// `2 x 128 MiB` per column family even when it writes little. With a budget, the write buffer
+/// manager is the budget, each column family's memtable is `budget / 32` (1 to 128 MiB) and
+/// its history is bounded by [`BOUNDED_MEMTABLE_HISTORY`]. At most one flushed memtable per
+/// column family then stays charged, which keeps it well under half the budget, so a write
+/// stalled on the budget always ends with a flush.
+fn memtable_budget() -> Option<usize> {
+    parse_memtable_budget(std::env::var("N42_ROCKSDB_MEMTABLE_MB").ok().as_deref())
+}
+
+/// Parses `N42_ROCKSDB_MEMTABLE_MB`, see [`memtable_budget`].
+fn parse_memtable_budget(value: Option<&str>) -> Option<usize> {
+    let Some(value) = value.map(str::trim).filter(|v| !v.is_empty()) else {
+        return Some(DEFAULT_N42_MEMTABLE_BUDGET);
+    };
+    match value.parse::<usize>() {
+        Ok(0) => None,
+        Ok(mb) => Some(mb.saturating_mul(1 << 20)),
+        Err(_) => {
+            tracing::warn!(
+                target: "providers::rocksdb",
+                value,
+                "N42_ROCKSDB_MEMTABLE_MB is not a number of MiB, using the default"
+            );
+            Some(DEFAULT_N42_MEMTABLE_BUDGET)
+        }
+    }
+}
+
+/// Each column family's memtable size under a memtable budget, see [`memtable_budget`].
+fn bounded_memtable_size(budget: usize) -> usize {
+    (budget / 32).clamp(1 << 20, DEFAULT_WRITE_BUFFER_SIZE)
+}
