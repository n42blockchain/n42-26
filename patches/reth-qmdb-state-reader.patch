+//! Optional process-local state provider wrapping at an exact block hash.
+//!
+//! Registered chains can replace account/storage reads without changing provider
+//! selection or the engine's unpersisted overlay. Registration is explicit;
+//! ordinary Reth processes keep their existing behavior.
+
+use crate::StateProviderBox;
+use alloy_primitives::B256;
+use reth_storage_errors::provider::ProviderResult;
+use std::sync::{Arc, OnceLock};
+
+/// A chain-specific provider adapter. It must preserve block identity and the
+/// code/hash/history semantics of the wrapped provider.
+pub trait BlockStateAdapter: Send + Sync + 'static {
+    /// Wrap an already resolved provider. Missing state must remain an error;
+    /// implementations must not synthesize empty accounts or zero slots.
+    fn wrap(&self, hash: B256, inner: StateProviderBox) -> ProviderResult<StateProviderBox>;
+}
+
+static ADAPTER: OnceLock<Arc<dyn BlockStateAdapter>> = OnceLock::new();
+
+/// Install the adapter once, before the node starts.
+pub fn register(adapter: Arc<dyn BlockStateAdapter>) -> bool {
+    ADAPTER.set(adapter).is_ok()
+}
+
+/// Adapt state only after Reth resolves the provider for the exact block hash.
+pub fn wrap(hash: B256, inner: StateProviderBox) -> ProviderResult<StateProviderBox> {
+    match ADAPTER.get() {
+        Some(adapter) => adapter.wrap(hash, inner),
+        None => Ok(inner),
+    }
+}
