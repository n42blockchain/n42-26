+    #[test]
+    fn on_inserted_executed_block_writes_only_a_cache_that_is_read() {
+        let block_hash = B256::repeat_byte(10u8);
+        let block_with_parent = BlockWithParent {
+            block: BlockNumHash { hash: block_hash, number: 1 },
+            parent: B256::repeat_byte(1u8),
+        };
+        // (state cache disabled, shared with the payload builder) -> written
+        for (disabled, shared, written) in
+            [(false, false, true), (true, false, false), (true, true, true), (false, true, true)]
+        {
+            let config = TreeConfig::default()
+                .without_state_cache(disabled)
+                .with_share_execution_cache_with_payload_builder(shared);
+            let payload_processor = PayloadProcessor::new(
+                reth_tasks::Runtime::test(),
+                EthEvmConfig::new(Arc::new(ChainSpec::default())),
+                &config,
+                PrecompileCacheMap::default(),
+            );
+            payload_processor.on_inserted_executed_block(block_with_parent, &BundleState::default());
+            assert_eq!(
+                payload_processor.execution_cache.get_cache_for(block_hash).is_some(),
+                written,
+                "state cache disabled: {disabled}, shared with the builder: {shared}"
+            );
+        }
+    }
