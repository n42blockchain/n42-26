+/// Whether canonical-state notifications for plain chain extensions are built
+/// and sent by a worker instead of the engine thread (`N42_CANON_NOTIFY_LATE=1`).
+fn canon_notify_late() -> bool {
+    static ON: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *ON.get_or_init(|| std::env::var("N42_CANON_NOTIFY_LATE").is_ok_and(|v| v == "1"))
+}
+
+/// Runs `job` on a single worker thread, in the order the jobs were handed over.
+fn run_in_commit_order(job: Box<dyn FnOnce() + Send>) {
+    static WORKER: std::sync::OnceLock<std::sync::mpsc::Sender<Box<dyn FnOnce() + Send>>> =
+        std::sync::OnceLock::new();
+    let sender = WORKER.get_or_init(|| {
+        let (sender, receiver) = std::sync::mpsc::channel::<Box<dyn FnOnce() + Send>>();
+        std::thread::Builder::new()
+            .name("canon-notify".into())
+            .spawn(move || {
+                for job in receiver {
+                    job();
+                }
+            })
+            .expect("spawn canon-notify worker");
+        sender
+    });
+    // The worker only stops when the process does; run inline if it is gone.
+    if let Err(std::sync::mpsc::SendError(job)) = sender.send(job) {
+        job();
+    }
+}
