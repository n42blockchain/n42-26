+
+/// The provider block execution reads the state at `hash` through: `inner` as it is when no
+/// adapter is installed, adapted like [`wrap`] otherwise.
+pub fn execution_provider<P>(hash: B256, inner: P) -> ProviderResult<EvmStateProviderBox>
+where
+    P: StateProvider + Send + 'static,
+{
+    if ADAPTER.get().is_none() {
+        return Ok(Box::new(inner.into_evm_state_provider()))
+    }
+    Ok(Box::new(wrap(hash, Box::new(inner))?.into_evm_state_provider()))
+}
