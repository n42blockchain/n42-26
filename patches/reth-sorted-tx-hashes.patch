+    #[test]
+    fn test_sorted_tx_hashes_write_the_same_entries() {
+        let blocks: Vec<_> =
+            reth_chain_state::test_utils::TestBlockBuilder::eth().get_executed_blocks(1..12).collect();
+        let mut first = 0;
+        let tx_nums: Vec<_> = blocks
+            .iter()
+            .map(|block| {
+                let at = first;
+                first += block.recovered_block().body().transaction_count() as u64;
+                at
+            })
+            .collect();
+        assert!(first > 4, "the blocks carry transactions: {first}");
+
+        let in_block_order = tx_hash_entries(&blocks, &tx_nums, false);
+        let in_hash_order = tx_hash_entries(&blocks, &tx_nums, true);
+        assert!(in_hash_order.windows(2).all(|pair| pair[0].0 < pair[1].0));
+        let mut resorted = in_block_order.clone();
+        resorted.sort_unstable();
+        assert_eq!(resorted, in_hash_order);
+
+        let dump = |entries: Vec<(TxHash, TxNumber)>| {
+            let dir = TempDir::new().unwrap();
+            let provider = RocksDBBuilder::new(dir.path()).with_default_tables().build().unwrap();
+            let mut batch = provider.batch();
+            for (hash, number) in entries {
+                batch.put::<tables::TransactionHashNumbers>(hash, &number).unwrap();
+            }
+            provider.commit_batch(batch.into_inner()).unwrap();
+            provider
+                .iter::<tables::TransactionHashNumbers>()
+                .unwrap()
+                .map(|entry| entry.unwrap())
+                .collect::<Vec<_>>()
+        };
+        assert_eq!(dump(in_block_order), dump(in_hash_order));
+    }
