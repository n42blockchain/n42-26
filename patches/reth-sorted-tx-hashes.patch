+/// `N42_SORTED_TX_HASHES=1`: a batch's transaction hashes are put in key
+/// order. Each put then lands next to the previous one in the memtable, which
+/// makes the commit's memtable insert cheaper than for hashes in block order;
+/// the batch holds the same entries.
+fn sorted_tx_hashes() -> bool {
+    static ON: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *ON.get_or_init(|| std::env::var("N42_SORTED_TX_HASHES").is_ok_and(|v| v == "1"))
+}
+
+/// The `(hash, number)` of every transaction of `blocks`, in block order, or
+/// in hash order when `sorted`.
+fn tx_hash_entries<N: reth_node_types::NodePrimitives>(
+    blocks: &[ExecutedBlock<N>],
+    tx_nums: &[TxNumber],
+    sorted: bool,
+) -> Vec<(TxHash, TxNumber)> {
+    let mut entries = Vec::with_capacity(
+        blocks.iter().map(|block| block.recovered_block().body().transaction_count()).sum(),
+    );
+    for (block, &first_tx_num) in blocks.iter().zip(tx_nums) {
+        let body = block.recovered_block().body();
+        entries.extend(
+            body.transactions_iter()
+                .zip(first_tx_num..)
+                .map(|(transaction, tx_num)| (*transaction.tx_hash(), tx_num)),
+        );
+    }
+    if sorted {
+        entries.par_sort_unstable_by_key(|(hash, _)| *hash);
+    }
+    entries
+}
