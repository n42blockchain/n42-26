+/// `N42_SF_PARALLEL_FINALIZE=1`: a commit writes the segments' configurations
+/// each on its own thread instead of one after another. Each write ends in a
+/// file and a directory sync; concurrent syncs share the filesystem's log
+/// flushes instead of queueing one behind the other, which is what the serial
+/// writes cost when the disk is busy.
+fn parallel_finalize() -> bool {
+    static ON: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *ON.get_or_init(|| std::env::var("N42_SF_PARALLEL_FINALIZE").is_ok_and(|v| v == "1"))
+}
