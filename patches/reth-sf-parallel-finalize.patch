+++ b/crates/storage/provider/src/providers/static_file/writer_tests.rs
@@ -136,6 +136,76 @@ mod tests {
         jar_provider.rows() as u64
     }
 
+    // ==================== PARALLEL FINALIZE ====================
+
+    /// The files one segment finalize after another leaves are the files
+    /// finalizing them in parallel leaves, block by block across file
+    /// boundaries, and both read back the same after a reopen.
+    #[test]
+    fn test_parallel_finalize_writes_the_same_files() {
+        use alloy_consensus::Header;
+        use alloy_primitives::B256;
+        use reth_db::models::StorageBeforeTx;
+
+        let write = |parallel: bool| {
+            let dir = tempfile::tempdir().unwrap();
+            let provider = setup_test_provider(&dir, 4);
+            for block in 0..11u64 {
+                {
+                    let mut writer = provider.latest_writer(StaticFileSegment::Headers).unwrap();
+                    let header = Header { number: block, gas_limit: 30_000_000, ..Default::default() };
+                    writer.append_header(&header, &B256::with_last_byte(block as u8)).unwrap();
+                    writer.sync_all().unwrap();
+                }
+                {
+                    let mut writer =
+                        provider.latest_writer(StaticFileSegment::AccountChangeSets).unwrap();
+                    writer
+                        .append_account_changeset(generate_test_changeset(block, 3), block)
+                        .unwrap();
+                    writer.sync_all().unwrap();
+                }
+                {
+                    let mut writer =
+                        provider.latest_writer(StaticFileSegment::StorageChangeSets).unwrap();
+                    let change = StorageBeforeTx {
+                        address: Address::with_last_byte(block as u8),
+                        key: B256::with_last_byte(7),
+                        value: U256::from(block),
+                    };
+                    writer.append_storage_changeset(vec![change], block).unwrap();
+                    writer.sync_all().unwrap();
+                }
+                provider.finalize_with(parallel).unwrap();
+            }
+            let mut files: Vec<_> = std::fs::read_dir(dir.path())
+                .unwrap()
+                .map(|entry| {
+                    let path = entry.unwrap().path();
+                    (path.file_name().unwrap().to_owned(), std::fs::read(&path).unwrap())
+                })
+                .collect();
+            files.sort();
+            let reopened = setup_test_provider(&dir, 4);
+            let read_back: Vec<_> = (0..11u64)
+                .map(|block| reopened.account_block_changeset(block).unwrap())
+                .collect();
+            (dir, files, read_back)
+        };
+        let (_serial_dir, serial, serial_read) = write(false);
+        let (_parallel_dir, parallel, parallel_read) = write(true);
+        assert!(serial.len() > 6, "several files per segment: {}", serial.len());
+        assert_eq!(
+            serial.iter().map(|(name, _)| name).collect::<Vec<_>>(),
+            parallel.iter().map(|(name, _)| name).collect::<Vec<_>>()
+        );
+        for ((name, serial), (_, parallel)) in serial.iter().zip(&parallel) {
+            assert_eq!(serial, parallel, "{name:?}");
+        }
+        assert_eq!(serial_read, parallel_read);
+        assert_eq!(serial_read[10].len(), 3);
+    }
+
