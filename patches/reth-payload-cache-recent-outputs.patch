+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn an_execution_output_survives_the_next_payloads() {
+        // Hashes no other test stores under: the cache is the process's.
+        let hash = |n: u8| B256::repeat_byte(0xc0 | n);
+        store_payload_execution(hash(1), 1u64);
+        store_payload_execution(hash(2), 2u64);
+        assert_eq!(take_payload_execution::<u64>(&hash(1)), Some(1));
+        assert_eq!(take_payload_execution::<u64>(&hash(1)), None, "an output is taken once");
+        assert_eq!(take_payload_execution::<u64>(&hash(2)), Some(2));
+
+        // A second output for one hash replaces the first.
+        store_payload_execution(hash(3), 3u64);
+        store_payload_execution(hash(3), 30u64);
+        assert_eq!(take_payload_execution::<u64>(&hash(3)), Some(30));
+        assert_eq!(take_payload_execution::<u64>(&hash(3)), None);
+
+        // The oldest goes once more than the bound are held.
+        for n in 0..=PAYLOAD_EXECUTIONS as u8 {
+            store_payload_execution(hash(4 + n), u64::from(n));
+        }
+        assert_eq!(take_payload_execution::<u64>(&hash(4)), None);
+        for n in 1..=PAYLOAD_EXECUTIONS as u8 {
+            assert_eq!(take_payload_execution::<u64>(&hash(4 + n)), Some(u64::from(n)));
+        }
+    }
+}
