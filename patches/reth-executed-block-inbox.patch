diff --git a/crates/node/builder/src/n42_executed.rs b/crates/node/builder/src/n42_executed.rs
new file mode 100644
index 000000000..83d4cec96
--- /dev/null
+++ b/crates/node/builder/src/n42_executed.rs
@@ -0,0 +1,52 @@
+//! Inbox for blocks an N42 block producer hands to the engine tree already executed.
+//!
+//! The engine launcher forwards each submission to the tree as an
+//! `InsertExecutedBlock` request, the path locally built payloads take. The block is
+//! type-erased here because the launcher is generic over the node's primitives.
+
+use std::{
+    any::Any,
+    sync::{Mutex, OnceLock},
+};
+use tokio::sync::{mpsc, oneshot};
+
+/// A block submitted through [`submit_executed_block`].
+pub(crate) struct ExecutedBlockSubmission {
+    /// A `BuiltPayloadExecutedBlock` of the node's primitives.
+    pub(crate) block: Box<dyn Any + Send>,
+    /// Answered once the request is queued for the tree: `false` if the block is not
+    /// of the node's primitives.
+    pub(crate) queued: oneshot::Sender<bool>,
+}
+
+struct Inbox {
+    sender: mpsc::UnboundedSender<ExecutedBlockSubmission>,
+    receiver: Mutex<Option<mpsc::UnboundedReceiver<ExecutedBlockSubmission>>>,
+}
+
+fn inbox() -> &'static Inbox {
+    static INBOX: OnceLock<Inbox> = OnceLock::new();
+    INBOX.get_or_init(|| {
+        let (sender, receiver) = mpsc::unbounded_channel();
+        Inbox { sender, receiver: Mutex::new(Some(receiver)) }
+    })
+}
+
+/// Queues `block`, a `BuiltPayloadExecutedBlock` of the node's primitives, for insertion
+/// into the engine tree without validation.
+///
+/// The returned receiver yields `true` once the insertion is queued ahead of every
+/// engine message sent afterwards, and `false` (or an error) if no engine took it. The
+/// caller vouches for the block: its execution output, hashed state and state root are
+/// not checked.
+pub fn submit_executed_block(block: Box<dyn Any + Send>) -> oneshot::Receiver<bool> {
+    let (queued, answer) = oneshot::channel();
+    // A closed channel drops `queued`, which the caller sees as an error.
+    let _ = inbox().sender.send(ExecutedBlockSubmission { block, queued });
+    answer
+}
+
+/// Takes the receiving end; the first engine launched in the process owns it.
+pub(crate) fn take_receiver() -> Option<mpsc::UnboundedReceiver<ExecutedBlockSubmission>> {
+    inbox().receiver.lock().ok().and_then(|mut receiver| receiver.take())
+}
