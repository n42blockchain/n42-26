diff --git a/crates/evm/evm/src/payload_cache.rs b/crates/evm/evm/src/payload_cache.rs
index 10ab99ee4..1a2a1c18c 100644
--- a/crates/evm/evm/src/payload_cache.rs
+++ b/crates/evm/evm/src/payload_cache.rs
@@ -10,6 +10,23 @@ use std::{
     sync::{Mutex, OnceLock},
 };
 
+/// A payload was validated against a cached execution output and failed.
+///
+/// The output came from outside the block (a peer, or a builder result moved
+/// to another hash), so the failure says nothing about the block itself. The
+/// engine reports the payload invalid without remembering its hash, and the
+/// caller may submit it again to have it executed.
+#[derive(Debug)]
+pub struct CachedExecutionRefused(pub String);
+
+impl core::fmt::Display for CachedExecutionRefused {
+    fn fmt(&self, f: &mut core::fmt::Formatter<'_>) -> core::fmt::Result {
+        write!(f, "cached execution output refused: {}", self.0)
+    }
+}
+
+impl core::error::Error for CachedExecutionRefused {}
+
 struct CachedPayload {
     block_hash: B256,
     data: Box<dyn Any + Send + Sync>,
