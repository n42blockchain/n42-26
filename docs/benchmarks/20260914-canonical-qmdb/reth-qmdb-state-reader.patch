+++ b/crates/storage/storage-api/src/n42_state.rs
@@ -0,0 +1,33 @@
+//! Optional, process-local state provider wrapping at an exact block hash.
+//!
+//! Registered chains can replace account/storage reads without changing reth's
+//! provider selection or the engine's unpersisted overlay. Registration is
+//! explicit; ordinary reth processes retain their existing behavior.
+
+use crate::StateProviderBox;
+use alloy_primitives::B256;
+use reth_storage_errors::provider::ProviderResult;
+use std::sync::{Arc, OnceLock};
+
+/// A chain-specific provider adapter. It must preserve the requested block's
+/// identity and the code/hash/history semantics of `inner`.
+pub trait BlockStateAdapter: Send + Sync + 'static {
+    /// Wrap an already resolved provider, or return an error. Missing state
+    /// must never become an empty account or zero slot.
+    fn wrap(&self, hash: B256, inner: StateProviderBox) -> ProviderResult<StateProviderBox>;
+}
+
+static ADAPTER: OnceLock<Arc<dyn BlockStateAdapter>> = OnceLock::new();
+
+/// Install one adapter before starting the node. A second registration fails.
+pub fn register(adapter: Arc<dyn BlockStateAdapter>) -> bool {
+    ADAPTER.set(adapter).is_ok()
+}
+
+/// Adapt the state at `hash`, after reth has resolved that exact block.
+pub fn wrap(hash: B256, inner: StateProviderBox) -> ProviderResult<StateProviderBox> {
+    match ADAPTER.get() {
+        Some(adapter) => adapter.wrap(hash, inner),
+        None => Ok(inner),
+    }
+}
